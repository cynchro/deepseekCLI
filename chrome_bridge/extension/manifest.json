{
  "manifest_version": 3,
  "name": "deepseekcli Browser Bridge",
  "description": "Permite que el agente de deepseekcli controle esta ventana de Chrome (tu perfil real, logueado) via chrome.debugger.",
  "version": "0.1.0",
  "key": "",
  "permissions": ["debugger", "nativeMessaging", "tabs", "activeTab", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "deepseekcli Browser Bridge",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "minimum_chrome_version": "116"
}
